# ========================================================================
# KrishiSetu Environment Configuration (MongoDB Atlas & Node Backend)
# ========================================================================

# 1. MongoDB Database Configuration (MongoDB Atlas Cloud Cluster)
# Get your connection string from MongoDB Atlas Dashboard: https://cloud.mongodb.com/
# NEVER expose this URI with VITE_* or in client-side code!
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/krishisetu?retryWrites=true&w=majority
# Local dev fallback only (if running mongod locally):
# MONGODB_DEV_URI=mongodb://localhost:27017/krishisetu_db

# 2. Protected Administrator Credentials (Server-side Only)
# Admin credentials must be kept confidential on server.
ADMIN_PHONE=your_admin_phone_number
ADMIN_PASSWORD=your_secure_admin_password

# 3. Server Configuration
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001

# 4. Authentication & Session Secrets (JWT)
AUTH_SECRET=krishisetu_super_secret_jwt_auth_key_replace_in_production_9142
JWT_SECRET=krishisetu_super_secret_jwt_auth_key_replace_in_production_9142
AUTH_URL=http://localhost:3001
JWT_EXPIRES_IN=7d

# 5. Media & Verification Document Storage
CLOUDINARY_CLOUD_NAME=krishisetu-agro
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 6. Mobile OTP Gateway Provider (mock / fast2sms / twilio)
OTP_PROVIDER=mock
ALLOW_DEV_OTP=true
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
