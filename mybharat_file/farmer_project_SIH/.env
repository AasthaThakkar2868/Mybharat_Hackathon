# ========================================================================
# KrishiSetu Local Environment Configuration
# ========================================================================

# 1. MongoDB Database Configuration (MongoDB Atlas Cloud Cluster)
# Set your MongoDB Atlas cluster URI here:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/krishisetu?retryWrites=true&w=majority
MONGODB_DEV_URI=mongodb://localhost:27017/krishisetu_db

# 2. Protected Admin Portal Credentials (Server-only)
ADMIN_PHONE=9274288006
ADMIN_PASSWORD=123456789

# 3. Server Configuration
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001

# 4. Authentication & Session Secrets
AUTH_SECRET=krishisetu_local_secret_key_84920481239
JWT_SECRET=krishisetu_local_secret_key_84920481239
AUTH_URL=http://localhost:3001
JWT_EXPIRES_IN=7d

# 5. Storage & OTP Providers
OTP_PROVIDER=mock
ALLOW_DEV_OTP=true
CLOUDINARY_CLOUD_NAME=krishisetu-local
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 6. Google Gemini AI Configuration
VITE_GEMINI_API_KEY=
